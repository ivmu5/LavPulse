<Project>
  <PropertyGroup>
    <!-- Keep platform projects in the same source directory without sharing NuGet assets. -->
    <LavPulseBuildHost Condition="'$(OS)' == 'Windows_NT'">windows</LavPulseBuildHost>
    <LavPulseBuildHost Condition="'$(LavPulseBuildHost)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</LavPulseBuildHost>
    <LavPulseBuildHost Condition="'$(LavPulseBuildHost)' == ''">unix</LavPulseBuildHost>
    <LavPulseBuildProfile Condition="'$(LavPulsePlatform)' == 'ios' or '$(LavPulsePlatform)' == 'maccatalyst'">$(LavPulsePlatform)</LavPulseBuildProfile>
    <LavPulseBuildProfile Condition="'$(LavPulseBuildProfile)' == ''">default</LavPulseBuildProfile>
    <LavPulseBuildDirectory>$(LavPulseBuildHost)/$(MSBuildProjectName)/$(LavPulseBuildProfile)</LavPulseBuildDirectory>
    <!-- Directory.Build.props runs before TargetFramework is read. Use the Android project names
         to shorten AAPT2 paths without sharing NuGet assets with the neighboring WinUI projects. -->
    <LavPulseBuildDirectory Condition="'$(LavPulseBuildHost)' == 'windows' and ('$(MSBuildProjectName)' == 'LavPulse.Android' or '$(MSBuildProjectName)' == 'LavPulse.Controls.Android')">android</LavPulseBuildDirectory>
    <BaseIntermediateOutputPath>obj/$(LavPulseBuildDirectory)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(LavPulseBuildDirectory)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
