<Project>
  <Import Project="../../MauiPlatforms.props" />
  <Import Project="../../Version.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Laveyana.LavPulse</RootNamespace>
    <AssemblyName>Laveyana.LavPulse</AssemblyName>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Keep the SDK from restoring a desktop runtime in Android Release builds. -->
    <UseDefaultPublishRuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseDefaultPublishRuntimeIdentifier>
    <!-- Use runtime JNI registration for the Android test player. -->
    <AndroidEnableMarshalMethods Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableMarshalMethods>
    <ApplicationTitle>LavPulse</ApplicationTitle>
    <!-- Preserve the installed package and its data across the project rename. -->
    <ApplicationId>com.laveyana.lavpulse.mixer</ApplicationId>
    <Version>$(LavPulseFullVersion)</Version>
    <AssemblyVersion>$(LavPulseFullVersion)</AssemblyVersion>
    <FileVersion>$(LavPulseFullVersion)</FileVersion>
    <InformationalVersion>$(LavPulseFullVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationDisplayVersion>$(LavPulseFullVersion)</ApplicationDisplayVersion>
    <!-- Android requires a positive integer versionCode; calendar ordering is preserved. -->
    <ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(LavPulseVersionMajor)$(LavPulseVersionYear)$(LavPulseVersionMonth)$(LavPulseVersionRevision)</ApplicationVersion>
    <!-- Windows consumes the four-part display version directly, not Android's integer code. -->
    <ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"></ApplicationVersion>
    <!-- Apple marketing versions must contain exactly three integer components. -->
    <ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(LavPulseVersionMajor).$(LavPulseVersionYear).$(LavPulseVersionMonth)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(LavPulseVersionYear).$(LavPulseVersionMonth).$(LavPulseVersionRevision)</ApplicationVersion>
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Platforms/Windows/lavpulse.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- These publish properties belong to the executable, not the Controls library.
       Use the MAUI RID override workaround without passing SelfContained to project references. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../../src/Laveyana.Audio.Playback/Laveyana.Audio.Playback.csproj" />
    <MauiFont Include="Resources/Fonts/InterVariable.ttf" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appicon_mark.png" Color="#0B1020" />
    <MauiSplashScreen Include="Resources/Splash/splash.png" Color="#0B1020" BaseSize="192,192" />
    <MauiImage Include="Resources/Images/lavpulse_mark.png" BaseSize="132,75" />
    <MauiImage Include="Resources/Images/Transport/*.svg" BaseSize="24,24" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Laveyana.Maui.UI.Android" Version="[$(LaveyanaMauiUiVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!-- Keep platform implementations separate in compiler and IDE builds. -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs;Apple/**/*.cs" />
    <Compile Include="Platforms/Android/**/*.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <Compile Include="Platforms/Windows/**/*.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <Compile Include="Platforms/iOS/**/*.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <Compile Include="Platforms/MacCatalyst/**/*.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <!-- MAUI SingleProject filters out platform folders other than the selected target. -->
    <Compile Include="Apple/**/*.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
  </ItemGroup>
</Project>
